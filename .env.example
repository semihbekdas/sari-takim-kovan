# Kovan yapılandırma örneği. Kopyalayın:  cp .env.example .env
# .env ASLA commit'lenmez (repo public). Ayrıntılar: docs/architecture.md § 8

# --- Uygulama ---
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR

# --- Veritabanları ---
DATABASE_URL=postgresql+psycopg://kovan:kovan_dev_password@localhost:5432/kovan
QDRANT_URL=http://localhost:6333

# --- Yapay zeka (varsayılan: fake mod, API anahtarı gerekmez) ---
CHAT_PROVIDER=fake                # fake | anthropic | openai_compatible
CHAT_MODEL=claude-opus-5-5        # sağlayıcıya göre model kimliği (seçenekler: ADR-006)
CHAT_BASE_URL=                    # yalnızca openai_compatible için
CHAT_MAX_TOKENS=4096              # üst sınır; Claude'un düşünme token'ları da buna dahil
CHAT_EFFORT=low                   # Claude için: low | medium | high | xhigh | max (boş = gönderme)
AI_TIMEOUT_SECONDS=30

EMBEDDING_PROVIDER=fake           # fake | openai_compatible
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536                # model değişirse indeks yeniden üretilir (docs/adr/ADR-005, "Kurtarma")

# Her anahtar yalnızca kendi sağlayıcısına gönderilir; birinin yerine diğeri kullanılmaz.
CHAT_API_KEY=                     # CHAT_PROVIDER'daki sağlayıcının anahtarı (Anthropic, OpenAI, Gemini …)
EMBEDDING_API_KEY=                # EMBEDDING_BASE_URL'deki sağlayıcının anahtarı

# --- RAG ve indeksleme ---
RAG_TOP_K=6
SEARCH_MIN_SCORE=0.35
INDEX_SETTLE_SECONDS=10

# --- Güvenlik ---
# Kendi değerinizi üretin (en az 32 bayt):  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
SESSION_COOKIE_SECURE=false       # prod'da (HTTPS) true
